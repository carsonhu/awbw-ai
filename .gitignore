/target
__pycache__/
*.pyc
data/prepared/
# Fetched map cache, except the canonical training map: an ignored *directory*
# cannot have exceptions, so the contents are ignored instead.
data/maps/*
!data/maps/119544.json
python/*.pyd
python/*.so

# Trained weights: large, binary, and regenerated by python/bc.py.
checkpoints/

# Recorded games, written by python/record_games.py to be watched and thrown
# away. Regenerated from a checkpoint in seconds.
replays/
data/replays-mooo/
data/sprites/

# Grid output: one log per arm per run, written on whichever box ran it and
# carried home in the archive below. The log entry is the durable record.
logs/

# Result archives pulled off a rented box -- 100MB+ of checkpoints and logs,
# both of which are ignored in their unpacked form too.
*.tgz
